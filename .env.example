# Copy to .env and fill in. NEVER commit .env.

# --- Groq (free): https://console.groq.com/keys ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Check console.groq.com/docs/models and /docs/structured-outputs for a current model that supports json_schema.
GROQ_MODEL=openai/gpt-oss-20b

# --- Gemini (free, optional multimodal arm): https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Tuning ---
# Free tiers have tokens-per-minute caps. Lower this if you see "request too large".
MAX_CONTEXT_CHARS=16000
MAX_OUTPUT_TOKENS=3000
MAX_VALIDATION_ATTEMPTS=3
REQUEST_DELAY_S=2

# --- Optional local tracing with Arize Phoenix (pip extra: phoenix) ---
ENABLE_PHOENIX=0
